{
  "name": "@digua/http",
  "version": "1.8.1",
  "description": "框架无关的 HTTP 客户端：token 注入 / 单飞刷新 / 错误码转文案",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "axios": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "registry": "http://192.168.2.12:14873/"
  }
}
