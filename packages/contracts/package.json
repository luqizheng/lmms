{
  "name": "@digua/contracts",
  "version": "0.1.0",
  "description": "后端契约编译产物：错误码、权限码与 OpenAPI 客户端 —— 与后端同源生成，不手写",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./error-codes": {
      "types": "./dist/error-codes.d.ts",
      "import": "./dist/error-codes.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "registry": "http://npm.kudi.repos/"
  }
}
