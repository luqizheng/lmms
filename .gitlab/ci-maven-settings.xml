<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI-only Maven settings.xml template for coder-micro-services.

  Used by .gitlab-ci.yml Java jobs (java_sdk_test, sdk_publish).
  Local dev uses .mvn/settings.xml (gitignored, generated by scripts/setup-wizard.js).

  This file is committed to the repo. It contains NO secrets.
  Credentials are interpolated from environment variables at runtime:

    MAVEN_USERNAME / MAVEN_PASSWORD    GitLab CI masked variables
                                        (sourced from secrets store, NOT this file)

  Maven supports ${env.VAR} interpolation in settings.xml since 3.0.
  Reference: https://maven.apache.org/settings.html#Settings

  ── Why no <mirrors> ──
  Reposilite is a hosted-only Maven repository by default — it does NOT proxy
  Maven Central. Adding <mirror>central → http://192.168.2.12:18181/releases
  would redirect all third-party downloads (jackson, junit, …) to Reposilite,
  which would 404 them. Third-party dependencies resolve from Maven Central
  directly. Internal io.digua:* artifacts resolve from the custom
  <repositories> declared below (which point to the same Reposilite host).

  If a future operator configures Reposilite as a Maven Central proxy, add a
  <mirror> block here mirroring central → http://192.168.2.12:18181/releases.

  ── Server IDs align with sdk/java/pom.xml <distributionManagement> ──
    - reposilite-repository-releases    →  http://192.168.2.12:18181/releases
    - reposilite-repository-snapshots   →  http://192.168.2.12:18181/snapshots
  Local dev .mvn/settings.xml uses the same IDs (hardcoded creds for the
  wizard-generated local file). CI injects credentials via env vars to keep
  this file safe to commit.

  ── Note on snapshot repo ──
  <snapshots><enabled>true</enabled> is set so -SNAPSHOT artifacts (if any
  SDK module or transitive dep uses one) resolve correctly. Reposilite's
  /snapshots endpoint is a separate repo from /releases; requests with
  non-SNAPSHOT versions fall through to /releases via Maven's repository
  resolver.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>
    <server>
      <id>reposilite-repository-releases</id>
      <username>${env.MAVEN_USERNAME}</username>
      <password>${env.MAVEN_PASSWORD}</password>
    </server>
    <server>
      <id>reposilite-repository-snapshots</id>
      <username>${env.MAVEN_USERNAME}</username>
      <password>${env.MAVEN_PASSWORD}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>coder-private-reposilite</id>
      <repositories>
        <repository>
          <id>reposilite-repository-releases</id>
          <name>Reposilite Repository</name>
          <url>http://192.168.2.12:18181/releases</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>reposilite-repository-snapshots</id>
          <name>Reposilite Snapshots</name>
          <url>http://192.168.2.12:18181/snapshots</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>reposilite-repository-releases</id>
          <name>Reposilite Repository</name>
          <url>http://192.168.2.12:18181/releases</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
        <pluginRepository>
          <id>reposilite-repository-snapshots</id>
          <name>Reposilite Snapshots</name>
          <url>http://192.168.2.12:18181/snapshots</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>coder-private-reposilite</activeProfile>
  </activeProfiles>
</settings>