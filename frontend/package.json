{
  "name": "@digua/prism-console",
  "version": "7.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "pnpm run build:packages && rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "pnpm run build:packages && rimraf dist && vite build --mode staging",
    "build:packages": "pnpm --filter @digua/contracts --filter @digua/http run build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "pnpm run build:packages && vue-tsc --noEmit --skipLibCheck",
    "check:vitest-coverage": "node ../scripts/check-vitest-coverage.js",
    "check:prism-tokens": "node ../scripts/check-prism-tokens.js",
    "test:unit": "pnpm run build:packages && vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "clean:cache": "rimraf .eslintcache && rimraf pnpm-lock.yaml && rimraf node_modules && pnpm store prune && pnpm install",
    "lint:eslint": "eslint --cache --max-warnings 0 src build --fix",
    "lint:prettier": "prettier --write \"src/**/*.{js,ts,json,tsx,css,vue,html,md}\"",
    "lint": "pnpm lint:eslint && pnpm lint:prettier"
  },
  "keywords": [
    "admin",
    "vue3",
    "design-system",
    "prism"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@digua/contracts": "workspace:*",
    "@digua/http": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.10",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=11"
  },
  "description": "PRISM 控制台 —— 公司自有 admin 前端（设计系统 + 壳 + 框架页）"
}
