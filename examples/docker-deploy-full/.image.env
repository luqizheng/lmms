# .image.env —— 部署单元镜像引用（发布即固化）
# ─────────────────────────────────────────────────────────────────────────────
# 本文件是镜像引用的唯一真相源：各 docker-compose*.yml 的 image: 只写变量名
# （${IMAGE_FILE_SERVICE} 等），具体镜像名与 tag 全在这里。
#
# 平台镜像段 —— 机器生成：由 `node scripts/update-image-env.js` 或
# `coder release images` 重写；版本号来自根 Cargo.toml 的
# [workspace.package].version（8 个 services/* 继承）。
# 基础镜像段 —— 版本独立（不跟平台版本走）：首次写入默认值，之后手工
# 升级某一行会被原样保留（换源 / 升 postgres 主版本都改这里）。
#
# 部署时 start.sh 会加载本文件（.env 之后加载 → 镜像钉版为权威）。
# 缺任何一条变量，compose 会在启动前直接报错，不会静默拉错镜像。
#
# 变量名 = IMAGE_ + 大写服务名；取值 = <registry>/<repo>/<image-name>:<tag>
#   - image-name 与 compose service 名不一定同名：prue_backend → prue-admin-backend
#   - tag 后缀：pg 方言加 -pg（1.7.0-pg）；mysql 方言无后缀；api-gateway 无 DB，两方言同 tag
# ─────────────────────────────────────────────────────────────────────────────

# ── 平台镜像：网关（无 DB，方言无关）──
IMAGE_API_GATEWAY=zhcoder-docker-registry.com:8000/micro-server/api-gateway:1.7.0

# ── 平台镜像：业务服务（带 DB，当前为 pg 方言）──
IMAGE_TOKEN_SERVICE=zhcoder-docker-registry.com:8000/micro-server/token-service:1.7.0-pg
IMAGE_IAM_SERVICE=zhcoder-docker-registry.com:8000/micro-server/iam-service:1.7.0-pg
IMAGE_NOTIFICATION_SERVICE=zhcoder-docker-registry.com:8000/micro-server/notification-service:1.7.0-pg
IMAGE_FILE_SERVICE=zhcoder-docker-registry.com:8000/micro-server/file-service:1.7.0-pg
IMAGE_AUDIT_SERVICE=zhcoder-docker-registry.com:8000/micro-server/audit-service:1.7.0-pg
IMAGE_PRUE_BACKEND=zhcoder-docker-registry.com:8000/micro-server/prue-admin-backend:1.7.0-pg

# ── 基础镜像：中间件（infra 片）──
IMAGE_CONSUL=zhcoder-docker-registry.com:8000/official/hashicorp/consul:2.0.1
IMAGE_REDIS=zhcoder-docker-registry.com:8000/official/redis:7-alpine
IMAGE_RABBITMQ=zhcoder-docker-registry.com:8000/official/rabbitmq:3.13-management-alpine
IMAGE_POSTGRES=zhcoder-docker-registry.com:8000/official/postgres:16

# ── 基础镜像：可观测（observability 片 + --logs 可选日志栈）──
IMAGE_PROMETHEUS=zhcoder-docker-registry.com:8000/official/prom/prometheus:v2.51.0
IMAGE_ALERTMANAGER=quay.io/prometheus/alertmanager:v0.27.0
IMAGE_GRAFANA=zhcoder-docker-registry.com:8000/official/grafana/grafana:10.4.0
IMAGE_CONSUL_TEMPLATE=zhcoder-docker-registry.com:8000/official/hashicorp/consul-template:0.32.0
IMAGE_OTEL_COLLECTOR=zhcoder-docker-registry.com:8000/official/otel/opentelemetry-collector-contrib:0.96.0
IMAGE_JAEGER=zhcoder-docker-registry.com:8000/official/jaegertracing/all-in-one:1.55
IMAGE_LOKI=zhcoder-docker-registry.com:8000/official/grafana/loki:3.3.2
IMAGE_PROMTAIL=zhcoder-docker-registry.com:8000/official/grafana/promtail:3.3.2
