# examples/docker-deploy/.image.env —— 本系统服务镜像引用（发布即固化）
# ─────────────────────────────────────────────────────────────────────────────
# 本文件是「本系统自建镜像」的唯一真相源：docker-compose-services.yml 的
# image: 只写变量名（${IMAGE_FILE_SERVICE} 等），具体镜像名与 tag 全在这里。
#
# 机器生成 —— 由 `node scripts/update-image-env.js -v <ver>` 或
# `coder release images` 整体重写；手工改动会在下次发布时被覆盖。
# 版本号本身来自根目录 release.toml（发布单一真相源）。
#
# 部署时 start.sh 会加载本文件（.env 之后加载 → 镜像钉版为权威）。
# 缺任何一条变量，compose 会在启动前直接报错，不会静默拉错镜像。
#
# 变量名 = IMAGE_ + 大写服务名；取值 = <registry>/<repo>/<image-name>:<tag>
#   - image-name 与 compose service 名不一定同名：prue_backend → prue-admin-backend
#   - tag 后缀：pg 方言加 -pg（1.7.0-pg）；mysql 方言无后缀；api-gateway 无 DB，两方言同 tag
# ─────────────────────────────────────────────────────────────────────────────

# ── 网关（无 DB，方言无关）──
IMAGE_API_GATEWAY=zhcoder-docker-registry.com:8000/micro-server/api-gateway:1.7.0

# ── 业务服务（带 DB，当前为 pg 方言）──
IMAGE_TOKEN_SERVICE=zhcoder-docker-registry.com:8000/micro-server/token-service:1.7.0-pg
IMAGE_IAM_SERVICE=zhcoder-docker-registry.com:8000/micro-server/iam-service:1.7.0-pg
IMAGE_NOTIFICATION_SERVICE=zhcoder-docker-registry.com:8000/micro-server/notification-service:1.7.0-pg
IMAGE_FILE_SERVICE=zhcoder-docker-registry.com:8000/micro-server/file-service:1.7.0-pg
IMAGE_AUDIT_SERVICE=zhcoder-docker-registry.com:8000/micro-server/audit-service:1.7.0-pg
IMAGE_PRUE_BACKEND=zhcoder-docker-registry.com:8000/micro-server/prue-admin-backend:1.7.0-pg
