# infrastructure/services/.env.example —— services 组自包含部署的环境模板
# ─────────────────────────────────────────────────────────────────────────────
# 用法：cp .env.example .env 后按环境改值（本文件入库无凭据；.env 不入库）。
# 仓内运行可跳过——start.sh 会向上回退命中 infrastructure/.env。
# 跨主机契约（模式 C）：CONSUL_ADDR/REDIS_HOST/RABBITMQ_HOST/DATABASE_URL/
# OTEL_EXPORTER_OTLP_ENDPOINT 全指他机 IP；SERVICE_ADDRESS=本机 LAN IP
# （consul 健康检查回拨地址，空值回退容器 hostname 仅同机有效）。
# 值为「三机各一台」示例拓扑（infra=.10 services=.4 obs=.11）；同机部署全部
# 留容器名默认即可。
# ─────────────────────────────────────────────────────────────────────────────

# ── lmms 镜像仓库与版本（发布即固化）──
kudi_repos=zhcoder-docker-registry.com:8000/micro-server
IMAGE_TAG_PG=1.7.0-pg
IMAGE_TAG_GATEWAY=1.7.0

# ── 服务发现与自注册（跨主机改 IP）──
CONSUL_ADDR=http://192.168.2.10:8500
SERVICE_ADDRESS=192.168.2.4
# 同机部署默认：
# CONSUL_ADDR=http://consul:8500
# SERVICE_ADDRESS=

# ── 中间件（跨主机改 infra 机 IP）──
REDIS_HOST=192.168.2.10
REDIS_PORT=6379
RABBITMQ_HOST=192.168.2.10
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=__SET_BY_OPS__
DATABASE_URL=postgres://postgres:coder@192.168.2.10:5432/coder

# ── 可观测（obs 机 OTLP；obs 缺席留默认，导出失败不阻塞业务）──
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.2.11:4317

# ── lmms 栈内互访常量（容器名 DNS，services 组内同机恒定）──
TENANT_ID=1
JWKS_URL=http://token-service:8082/.well-known/jwks.json

# ── Service-JWT bootstrap tokens（生产强随机）──
IAM_DEV_BT=__SET_BY_OPS__
TOKEN_DEV_BT=__SET_BY_OPS__
NOTIFICATION_DEV_BT=__SET_BY_OPS__
AUDIT_DEV_BT=__SET_BY_OPS__
PRUE_DEV_BT=__SET_BY_OPS__
GATEWAY_DEV_BT=__SET_BY_OPS__
FILE_DEV_BT=__SET_BY_OPS__
SERVICE_BOOTSTRAP_TOKENS=${IAM_DEV_BT},${TOKEN_DEV_BT},${NOTIFICATION_DEV_BT},${AUDIT_DEV_BT},${PRUE_DEV_BT},${GATEWAY_DEV_BT},${FILE_DEV_BT}
