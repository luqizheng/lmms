FROM zhcoder-docker-registry.com:8000/official/rust:1.96-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY libs ./libs
COPY services/token-service ./services/token-service
RUN cargo build --release -p token-service

FROM zhcoder-docker-registry.com:8000/official/alpine:3.21
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /app/target/release/token-service /usr/local/bin/token-service
COPY docker/config/token-service /app/config
COPY docker/secrets /app/secrets
EXPOSE 4000
CMD ["/usr/local/bin/token-service", "/app/config/config.yaml"]
