{
  "name": "coder-micro-services",
  "private": true,
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File tools/setup.ps1",
    "build": "cargo build --release --manifest-path services/api-gateway/Cargo.toml && cargo build --release --manifest-path services/token-service/Cargo.toml",
    "dev": "docker compose -f infrastructure/docker-compose.test-infra.yaml up -d && pnpm -r --parallel run dev",
    "dev:infra": "docker compose -f infrastructure/docker-compose.test-infra.yaml up -d",
    "test:reset": "powershell -ExecutionPolicy Bypass -File scripts/test-orchestrator.ps1 reset-db",
    "test:unit": "powershell -ExecutionPolicy Bypass -File scripts/test-orchestrator.ps1 test-unit",
    "test:integration": "powershell -ExecutionPolicy Bypass -File scripts/test-orchestrator.ps1 test-integration",
    "test:all": "powershell -ExecutionPolicy Bypass -File scripts/test-orchestrator.ps1 test-all",
    "test:report": "powershell -ExecutionPolicy Bypass -File scripts/test-orchestrator.ps1 report",
    "test:loop": "powershell -ExecutionPolicy Bypass -File scripts/test-orchestrator.ps1 loop",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean",
    "docker:build:api-gateway": "docker build -f services/api-gateway/Dockerfile -t zhcoder-docker-registry.com:8000/micro-server/api-gateway .",
    "docker:build:token-service": "docker build -f Dockerfile.token-service -t zhcoder-docker-registry.com:8000/micro-server/token-service .",
    "docker:build:user-service": "docker build -f services/user-service/Dockerfile -t zhcoder-docker-registry.com:8000/micro-server/user-service .",
    "docker:build": "pnpm run docker:build:api-gateway && pnpm run docker:build:token-service && pnpm run docker:build:user-service",
    "docker:push:api-gateway": "docker push zhcoder-docker-registry.com:8000/micro-server/api-gateway",
    "docker:push:token-service": "docker push zhcoder-docker-registry.com:8000/micro-server/token-service",
    "docker:push:user-service": "docker push zhcoder-docker-registry.com:8000/micro-server/user-service",
    "docker:push": "pnpm run docker:push:api-gateway && pnpm run docker:push:token-service && pnpm run docker:push:user-service",
    "sdk:test:java": "cd sdk/java && mvn -B test",
    "sdk:test:java:8": "cd sdk/java && mvn -B test -P java8",
    "sdk:test:java:17": "cd sdk/java && mvn -B test -P java17",
    "sdk:test:java:21": "cd sdk/java && mvn -B test -P java21",
    "sdk:test:dotnet": "cd sdk/dotnet && dotnet test --nologo --verbosity minimal",
    "sdk:test": "pnpm run sdk:test:java && pnpm run sdk:test:dotnet"
  }
}
