{
  "name": "coder-micro-services",
  "private": true,
  "scripts": {
    "build": "cargo build --release --manifest-path services/api-gateway/Cargo.toml && cargo build --release --manifest-path services/token-service/Cargo.toml",
    "dev:mysql": "docker compose -f infrastructure/lmms-mysql-dev/docker-compose.yml up -d && pnpm -r --parallel --if-present run dev",
    "dev:pg": "docker compose -f infrastructure/lmms-postgres-dev/docker-compose.yml up -d && pnpm -r --parallel --if-present run dev",
    "dev:infra:mysql": "docker compose -f infrastructure/infra-mysql/docker-compose.yml up -d",
    "dev:infra:pg": "docker compose -f infrastructure/infra-postgres/docker-compose.yml up -d",
    "check:gates": "node scripts/check-db-naming.js && node scripts/check-pg-migrations.js",
    "test": "pnpm -r --if-present run test",
    "clean": "pnpm -r --if-present run clean",
    "docker:build:docs-site": "node packages/cli/bin/coder.js build images docs-site",
    "docker:build": "node packages/cli/bin/coder.js build images",
    "docker:build:clean": "node packages/cli/bin/coder.js build images prune",
    "test:scripts": "node --test scripts/check-db-naming.test.js scripts/check-pg-migrations.test.js scripts/update-image-env.test.js",
    "deploy:image-env": "node scripts/update-image-env.js",
    "deploy:image-env:check": "node scripts/update-image-env.js --check",
    "test:cli": "pnpm --filter @digua/cli test",
    "release:status": "node packages/cli/bin/coder.js release status --strict",
    "release:images": "node packages/cli/bin/coder.js release images",
    "release:images:push": "node packages/cli/bin/coder.js release images --push",
    "release:sdk:rust": "node packages/cli/bin/coder.js release sdk rust",
    "release:sdk:npm": "node packages/cli/bin/coder.js release sdk npm",
    "release:sdk:java": "node packages/cli/bin/coder.js release sdk java",
    "coder": "node packages/cli/bin/coder.js",
    "sdk:test:java": "mvn -B test -f sdk/java/pom.xml",
    "sdk:test:java:8": "mvn -B test -f sdk/java/pom.xml -P java8",
    "sdk:test:java:17": "mvn -B test -f sdk/java/pom.xml -P java17",
    "sdk:test:java:21": "mvn -B test -f sdk/java/pom.xml -P java21",
    "sdk:test": "pnpm run sdk:test:java",
    "build:docker": "node packages/cli/bin/coder.js build images",
    "build:cargo": "node scripts/build-cargo.js",
    "check:service-standard": "node scripts/check-service-standard.js",
    "bench": "node scripts/bench.js",
    "bench:audit": "node scripts/bench.js audit-service",
    "bench:config": "node scripts/bench.js config-service",
    "bench:file": "node scripts/bench.js file-service",
    "sdk:generate": "node scripts/openapi-codegen.js",
    "sdk:generate:audit": "node scripts/openapi-codegen.js services/audit-service/openapi.yaml packages/contracts/src/sdk/audit",
    "sdk:generate:config": "node scripts/openapi-codegen.js services/config-service/openapi.yaml packages/contracts/src/sdk/config",
    "sdk:generate:file": "node scripts/openapi-codegen.js services/file-service/openapi.yaml packages/contracts/src/sdk/file",
    "sdk:generate:all": "pnpm run sdk:generate:audit && pnpm run sdk:generate:config && pnpm run sdk:generate:file",
    "contracts:gen": "node scripts/contracts-gen.js",
    "contracts:check": "node scripts/contracts-gen.js --check",
    "check:env": "node scripts/check-dev-env.js",
    "ai:review": "node scripts/ai-code-review.js",
    "ai:gen-e2e": "node scripts/gen-e2e-from-openapi.js",
    "check:spec": "node scripts/check-spec.js",
    "ci:local": "node scripts/ci-local-run.js",
    "ci:local:list": "node scripts/ci-local-run.js --list",
    "check:tenant-scope": "node scripts/check-tenant-scope.js",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "packages:build": "pnpm --filter @digua/contracts --filter @digua/http --filter @digua/iam-services --filter @digua/audit-services --filter @digua/file-services --filter @digua/notification-services --filter @digua/prue-services run build"
  },
  "dependencies": {
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "chalk": "^4.1.2",
    "js-yaml": "^5.2.1",
    "mysql2": "^3.22.6",
    "ora": "^5.4.1",
    "prompts": "^2.4.2",
    "vitepress": "^1.6.0",
    "vue": "3.5.35"
  }
}
