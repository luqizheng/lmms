{
  "name": "coder-micro-services",
  "private": true,
  "scripts": {
    "build": "cargo build --release --manifest-path services/api-gateway/Cargo.toml && cargo build --release --manifest-path services/token-service/Cargo.toml",
    "dev": "docker compose -f infrastructure/docker-compose.yml up -d && pnpm -r --parallel --if-present run dev",
    "dev:infra": "docker compose -f infrastructure/docker-compose.yml up -d",
    "dev:infra:e2e": "docker compose -f infrastructure/docker-compose.yml -f infrastructure/docker-compose-infra.dev.yml up -d",
    "dev:down": "docker compose -f infrastructure/docker-compose.yml down",
    "dev:restart": "docker compose -f infrastructure/docker-compose.yml restart",
    "dev:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "dev:ps": "docker compose -f infrastructure/docker-compose.yml ps",
    "dev:setup": "node scripts/dev-setup.js",
    "docker:compose:build": "docker compose -f infrastructure/docker-compose.yml build",
    "docker:compose:build:api-gateway": "docker compose -f infrastructure/docker-compose.yml build api-gateway",
    "docker:compose:build:token-service": "docker compose -f infrastructure/docker-compose.yml build token-service",
    "docker:compose:build:iam-service": "docker compose -f infrastructure/docker-compose.yml build iam-service",
    "docker:compose:build:notification-service": "docker compose -f infrastructure/docker-compose.yml build notification-service",
    "docker:compose:build:file-service": "docker compose -f infrastructure/docker-compose.yml build file-service",
    "docker:compose:build:config-service": "docker compose -f infrastructure/docker-compose.yml build config-service",
    "docker:compose:build:audit-service": "docker compose -f infrastructure/docker-compose.yml build audit-service",
    "docker:compose:build:prue-admin-backend": "docker compose -f infrastructure/docker-compose.yml build prue_backend",
    "setup": "pnpm install && node scripts/setup-wizard.js && pnpm run images:sync && pnpm run images:pull && pnpm run assets:download && pnpm run check:env",
    "setup:wizard": "node scripts/setup-wizard.js",
    "images:sync": "node scripts/base-images-sync.js",
    "images:check": "node scripts/base-images-sync.js --check",
    "images:pull": "node scripts/images-pull.js",
    "assets:download": "node packages/cli/bin/coder.js assets download",
    "assets:download:force": "node packages/cli/bin/coder.js assets download --force",
    "assets:check": "node packages/cli/bin/coder.js assets download --check",
    "test:e2e": "node scripts/run-e2e-local.js",
    "test:e2e:api": "pnpm -C tests/e2e test:api",
    "test:e2e:smoke": "pnpm -C tests/e2e test:smoke",
    "test:rust": "node scripts/run-tests-docker.js",
    "test:rust:host": "node scripts/run-tests-host.js",
    "test:all": "pnpm run test && pnpm run test:rust && pnpm run test:e2e:smoke && pnpm run test:e2e:api && pnpm run test:scripts && pnpm run release:test && pnpm run test:cli",
    "check": "pnpm -r --if-present run check",
    "test": "pnpm -r --if-present run test",
    "clean": "pnpm -r --if-present run clean",
    "docker:build:api-gateway": "node packages/cli/bin/coder.js build images api-gateway",
    "docker:build:token-service": "node packages/cli/bin/coder.js build images token-service",
    "docker:build:iam-service": "node packages/cli/bin/coder.js build images iam-service",
    "docker:build:notification-service": "node packages/cli/bin/coder.js build images notification-service",
    "docker:build:file-service": "node packages/cli/bin/coder.js build images file-service",
    "docker:build:config-service": "node packages/cli/bin/coder.js build images config-service",
    "docker:build:audit-service": "node packages/cli/bin/coder.js build images audit-service",
    "docker:build:prue-admin-backend": "node packages/cli/bin/coder.js build images prue-admin-backend",
    "docker:build:docs-site": "node packages/cli/bin/coder.js build images docs-site",
    "docker:build": "node packages/cli/bin/coder.js build images",
    "docker:build:clean": "node packages/cli/bin/coder.js build images prune",
    "docker:demo:data": "node scripts/demo-data.js",
    "release:test": "node --test release/dist-template/scripts/release-transforms.test.js",
    "test:scripts": "node --test scripts/setup-wizard.test.js",
    "test:cli": "pnpm --filter @digua/cli test",
    "coder": "node packages/cli/bin/coder.js",
    "compose:template": "node packages/cli/bin/coder.js release compose-template",
    "release:build": "node release/dist-template/scripts/release.js",
    "sdk:test:java": "mvn -B test -f sdk/java/pom.xml",
    "sdk:test:java:8": "mvn -B test -f sdk/java/pom.xml -P java8",
    "sdk:test:java:17": "mvn -B test -f sdk/java/pom.xml -P java17",
    "sdk:test:java:21": "mvn -B test -f sdk/java/pom.xml -P java21",
    "sdk:test": "pnpm run sdk:test:java",
    "sdk:publish:release": "node packages/cli/bin/coder.js release publish maven",
    "sdk:publish:snapshot": "node packages/cli/bin/coder.js release publish maven --kind snapshot",
    "sdk:publish:libs": "node packages/cli/bin/coder.js release publish rust --targets libs",
    "sdk:publish:rust": "node packages/cli/bin/coder.js release publish rust",
    "build:docker": "node packages/cli/bin/coder.js build images",
    "build:cargo": "node scripts/build-cargo.js",
    "check:service-standard": "node scripts/check-service-standard.js",
    "bench": "node scripts/bench.js",
    "bench:audit": "node scripts/bench.js audit-service",
    "bench:config": "node scripts/bench.js config-service",
    "bench:file": "node scripts/bench.js file-service",
    "sdk:generate": "node scripts/openapi-codegen.js",
    "sdk:generate:audit": "node scripts/openapi-codegen.js services/audit-service/openapi.yaml packages/contracts/src/sdk/audit",
    "sdk:generate:config": "node scripts/openapi-codegen.js services/config-service/openapi.yaml packages/contracts/src/sdk/config",
    "sdk:generate:file": "node scripts/openapi-codegen.js services/file-service/openapi.yaml packages/contracts/src/sdk/file",
    "sdk:generate:all": "pnpm run sdk:generate:audit && pnpm run sdk:generate:config && pnpm run sdk:generate:file",
    "contracts:gen": "node scripts/contracts-gen.js",
    "contracts:check": "node scripts/contracts-gen.js --check",
    "check:env": "node scripts/check-dev-env.js",
    "ai:review": "node scripts/ai-code-review.js",
    "ai:gen-e2e": "node scripts/gen-e2e-from-openapi.js",
    "check:spec": "node scripts/check-spec.js",
    "ci:local": "node scripts/ci-local-run.js",
    "ci:local:list": "node scripts/ci-local-run.js --list",
    "check:tenant-scope": "node scripts/check-tenant-scope.js",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "packages:build": "pnpm --filter @digua/contracts --filter @digua/http run build",
    "packages:check": "node packages/cli/bin/coder.js release publish npm --dry-run",
    "packages:publish": "node packages/cli/bin/coder.js release publish npm"
  },
  "dependencies": {
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "chalk": "^4.1.2",
    "js-yaml": "^5.2.1",
    "mysql2": "^3.22.6",
    "ora": "^5.4.1",
    "prompts": "^2.4.2",
    "vitepress": "^1.6.0",
    "vue": "3.5.35"
  }
}
