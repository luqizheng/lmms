{
  "name": "coder-micro-services",
  "private": true,
  "scripts": {
    "build": "cargo build --release --manifest-path services/api-gateway/Cargo.toml && cargo build --release --manifest-path services/token-service/Cargo.toml",
    "dev": "docker compose -f infrastructure/docker-compose.yml up -d && pnpm -r --parallel run dev",
    "dev:infra": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:compose:build": "docker compose -f infrastructure/docker-compose.yml build",
    "docker:compose:build:api-gateway": "docker compose -f infrastructure/docker-compose.yml build api-gateway",
    "docker:compose:build:token-service": "docker compose -f infrastructure/docker-compose.yml build token-service",
    "docker:compose:build:iam-service": "docker compose -f infrastructure/docker-compose.yml build iam-service",
    "docker:compose:build:notification-service": "docker compose -f infrastructure/docker-compose.yml build notification-service",
    "docker:compose:build:file-service": "docker compose -f infrastructure/docker-compose.yml build file-service",
    "docker:compose:build:config-service": "docker compose -f infrastructure/docker-compose.yml build config-service",
    "docker:compose:build:audit-service": "docker compose -f infrastructure/docker-compose.yml build audit-service",
    "docker:compose:build:prue_backend": "docker compose -f infrastructure/docker-compose.yml build prue_backend",
    "docker:compose:build:frontend": "docker compose -f infrastructure/docker-compose.yml build frontend",
    "setup": "pnpm install && pnpm run images:sync && pnpm run images:pull && pnpm run check:env",
    "images:sync": "node scripts/base-images-sync.js",
    "images:check": "node scripts/base-images-sync.js --check",
    "images:pull": "node scripts/images-pull.js",
    "test:e2e": "node scripts/run-e2e-local.js",
    "test:e2e:auth": "pnpm -C tests/e2e test auth",
    "test:e2e:users": "pnpm -C tests/e2e test users",
    "test:e2e:tokens": "pnpm -C tests/e2e test tokens",
    "test:e2e:roles": "pnpm -C tests/e2e test roles",
    "test:e2e:permissions": "pnpm -C tests/e2e test permissions",
    "test:e2e:audit": "pnpm -C tests/e2e test audit",
    "test:e2e:config": "pnpm -C tests/e2e test config",
    "test:e2e:file": "pnpm -C tests/e2e test file",
    "test:e2e:notification": "pnpm -C tests/e2e test notification",
    "test:e2e:token-admin": "pnpm -C tests/e2e test token-admin",
    "test:e2e:menu-configs": "pnpm -C tests/e2e test menu-configs",
    "test:e2e:iam-orgs": "pnpm -C tests/e2e test iam-org-units",
    "test:e2e:gateway": "pnpm -C tests/e2e test gateway",
    "test:e2e:api": "pnpm -C tests/e2e test:api",
    "test:e2e:ui": "pnpm -C tests/e2e test:ui",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean",
    "docker:build:api-gateway": "node scripts/build-docker.js api-gateway",
    "docker:build:token-service": "node scripts/build-docker.js token-service",
    "docker:build:iam-service": "node scripts/build-docker.js iam-service",
    "docker:build:notification-service": "node scripts/build-docker.js notification-service",
    "docker:build:file-service": "node scripts/build-docker.js file-service",
    "docker:build:config-service": "node scripts/build-docker.js config-service",
    "docker:build:audit-service": "node scripts/build-docker.js audit-service",
    "docker:build:prue-backend": "node scripts/build-docker.js prue_backend",
    "docker:build:frontend": "node scripts/build-docker.js frontend",
    "docker:build": "node scripts/build-docker.js",
    "docker:build:clean": "node scripts/build-docker.js prune",
    "docker:demo:data": "node scripts/demo-data.js",
    "release:push": "node scripts/release-push.js",
    "sdk:test:java": "cd sdk/java && mvn -B test",
    "sdk:test:java:8": "cd sdk/java && mvn -B test -P java8",
    "sdk:test:java:17": "cd sdk/java && mvn -B test -P java17",
    "sdk:test:java:21": "cd sdk/java && mvn -B test -P java21",
    "sdk:test:dotnet": "cd sdk/dotnet && dotnet test --nologo --verbosity minimal",
    "sdk:test": "pnpm run sdk:test:java && pnpm run sdk:test:dotnet",
    "build:docker": "node scripts/build-docker.js",
    "build:cargo": "node scripts/build-cargo.js",
    "check:service-standard": "node scripts/check-service-standard.js",
    "bench": "node scripts/bench.js",
    "bench:audit": "node scripts/bench.js audit-service",
    "bench:config": "node scripts/bench.js config-service",
    "bench:file": "node scripts/bench.js file-service",
    "sdk:generate": "node scripts/openapi-codegen.js",
    "sdk:generate:audit": "node scripts/openapi-codegen.js services/audit-service/openapi.yaml frontend/src/api/audit",
    "sdk:generate:config": "node scripts/openapi-codegen.js services/config-service/openapi.yaml frontend/src/api/config",
    "sdk:generate:file": "node scripts/openapi-codegen.js services/file-service/openapi.yaml frontend/src/api/file",
    "sdk:generate:all": "pnpm sdk:generate:audit && pnpm sdk:generate:config && pnpm sdk:generate:file",
    "contracts:gen": "node scripts/contracts-gen.js",
    "contracts:check": "node scripts/contracts-gen.js --check",
    "check:env": "node scripts/check-dev-env.js",
    "ai:review": "node scripts/ai-code-review.js",
    "ai:gen-e2e": "node scripts/gen-e2e-from-openapi.js",
    "check:spec": "node scripts/check-spec.js",
    "check:tenant-scope": "node scripts/check-tenant-scope.js",
    "check:frontend-dead-code": "node scripts/check-frontend-dead-code.js",
    "check:vitest-coverage": "node scripts/check-vitest-coverage.js",
    "check:vitest-coverage:report": "node scripts/check-vitest-coverage.js --all",
    "check:frontend-i18n": "node scripts/check-i18n-hardcode.js",
    "check:frontend-i18n:report": "node scripts/check-i18n-hardcode.js --all",
    "check:frontend-v-perms": "node scripts/check-v-perms.js"
  },
  "dependencies": {
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "js-yaml": "^5.2.1",
    "mysql2": "^3.22.6"
  }
}
