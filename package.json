{
  "name": "coder-micro-services",
  "private": true,
  "scripts": {
    "setup": "node tools/setup.js",
    "build": "cargo build --release --manifest-path services/api-gateway/Cargo.toml && cargo build --release --manifest-path services/token-service/Cargo.toml",
    "dev": "docker compose -f infrastructure/docker-compose.yml up -d && pnpm -r --parallel run dev",
    "dev:infra": "docker compose -f infrastructure/docker-compose.yml up -d",
    "test:reset": "node scripts/test-orchestrator.js reset-db",
    "test:unit": "node scripts/test-orchestrator.js test-unit",
    "test:integration": "node scripts/test-orchestrator.js test-integration",
    "test:all": "node scripts/test-orchestrator.js test-all",
    "test:report": "node scripts/test-orchestrator.js report",
    "test:loop": "node scripts/test-orchestrator.js loop",
    "test:e2e": "pnpm -C tests/e2e test",
    "test:e2e:auth": "pnpm -C tests/e2e test auth",
    "test:e2e:users": "pnpm -C tests/e2e test users",
    "test:e2e:tokens": "pnpm -C tests/e2e test tokens",
    "test:e2e:roles": "pnpm -C tests/e2e test roles",
    "test:e2e:permissions": "pnpm -C tests/e2e test permissions",
    "test:e2e:docker": "node scripts/run-e2e.js",
    "test:e2e:docker:users": "node scripts/run-e2e.js --filter users",
    "test:e2e:docker:no-up": "node scripts/run-e2e.js --no-up",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean",
    "docker:build:api-gateway": "docker buildx build --load -f services/api-gateway/Dockerfile -t zhcoder-docker-registry.com:8000/micro-server/api-gateway .",
    "docker:build:token-service": "docker buildx build --load -f services/token-service/Dockerfile -t zhcoder-docker-registry.com:8000/micro-server/token-service .",
    "docker:build:user-service": "docker buildx build --load -f services/user-service/Dockerfile -t zhcoder-docker-registry.com:8000/micro-server/user-service .",
    "docker:build": "pnpm run docker:build:api-gateway && pnpm run docker:build:token-service && pnpm run docker:build:user-service",
    "docker:push:api-gateway": "docker push zhcoder-docker-registry.com:8000/micro-server/api-gateway",
    "docker:push:token-service": "docker push zhcoder-docker-registry.com:8000/micro-server/token-service",
    "docker:push:user-service": "docker push zhcoder-docker-registry.com:8000/micro-server/user-service",
    "docker:push": "pnpm run docker:push:api-gateway && pnpm run docker:push:token-service && pnpm run docker:push:user-service",
    "sdk:test:java": "cd sdk/java && mvn -B test",
    "sdk:test:java:8": "cd sdk/java && mvn -B test -P java8",
    "sdk:test:java:17": "cd sdk/java && mvn -B test -P java17",
    "sdk:test:java:21": "cd sdk/java && mvn -B test -P java21",
    "sdk:test:dotnet": "cd sdk/dotnet && dotnet test --nologo --verbosity minimal",
    "sdk:test": "pnpm run sdk:test:java && pnpm run sdk:test:dotnet",
    "build:docker": "node scripts/build-docker.js",
    "build:cargo": "node scripts/build-cargo.js",
    "check:service-standard": "node scripts/check-service-standard.js"
  }
}
