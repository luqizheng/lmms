# 基础编译镜像
FROM zhcoder-docker-registry.com:8000/official/rust:1.96-slim AS rust-builder-base

# 1. 更换 APT 源为阿里云（加速）
RUN sed -i "s@http://\(deb\|security\).debian.org@https://mirrors.aliyun.com@g" /etc/apt/sources.list.d/debian.sources
RUN export RUSTUP_DIST_SERVER="https://rsproxy.cn"
RUN export RUSTUP_UPDATE_ROOT="https://rsproxy.cn/rustup"
RUN curl --proto '=https' --tlsv1.2 -sSf https://rsproxy.cn/rustup-init.sh | sh
# 2. 安装编译所需系统工具
RUN apt update && \
    apt install -y \
        musl-tools \      
        pkg-config \     
        libssl-dev \    
        mold \            
        clang \          
        ca-certificates \ 
        curl \          
    && rm -rf /var/lib/apt/lists/*

# 3. 安装 cargo-chef（优化依赖层缓存）
RUN cargo install cargo-chef --locked

# 4. 添加 musl 目标（静态编译）
RUN rustup target add x86_64-unknown-linux-musl

# 5. 配置 Cargo 国内镜像源 + 使用 mold + clang 作为链接器
RUN mkdir -p /root/.cargo && cat > /root/.cargo/config.toml << 'EOF'
[source.crates-io]
replace-with = 'rsproxy-sparse'

[source.rsproxy]
registry = "https://rsproxy.cn/crates.io-index"

[source.rsproxy-sparse]
registry = "sparse+https://rsproxy.cn/index/"

[registries.rsproxy]
index = "https://rsproxy.cn/crates.io-index"

[net]
git-fetch-with-cli = true

[target.x86_64-unknown-linux-musl]
linker = "clang"
rustflags = ["-C", "link-arg=-fuse-ld=mold"]
EOF

# 6. （可选）设置工作目录（仅为约定，实际使用时可以在子镜像中覆盖）
WORKDIR /app

# 7. 设置环境变量（可选）
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV RUST_BACKTRACE=1
