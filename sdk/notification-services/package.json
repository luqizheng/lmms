{
  "name": "@digua/notification-services",
  "version": "1.8.3",
  "description": "lmms notification-service SDK：公告管理与未读数的零依赖 fetch 客户端（api-gateway /v1/notification 公开路径，不含 WS）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "registry": "http://192.168.2.12:14873/"
  }
}
