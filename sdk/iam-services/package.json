{
  "name": "@digua/iam-services",
  "version": "0.1.0",
  "description": "lmms IAM SDK：登录 / 用户管理 / token 管理的零依赖 fetch 客户端（api-gateway /v1 公开路径）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
