.PHONY: help secrets up down status logs verify load-images

REGISTRY ?= zhcoder-docker-registry.com:8000
IMAGE_TAG ?= v1.0.0

help:
	@echo "coder-micro-services ${IMAGE_TAG} — 纯部署包"
	@echo ""
	@echo "  make secrets         生成 JWT 密钥 + 随机密码，初始化 .env"
	@echo "  make up              启动所有服务（使用预构建镜像，无需本地 build）"
	@echo "  make down            停止所有容器（保留数据卷）"
	@echo "  make status          列出所有容器状态"
	@echo "  make logs [svc=]     查看日志（可指定服务名）"
	@echo "  make verify          端到端冒烟测试"
	@echo "  make load-images     从离线 tar 加载 Docker 镜像（air-gap）"
	@echo ""
	@echo "环境变量：REGISTRY=${REGISTRY}  IMAGE_TAG=${IMAGE_TAG}"
	@echo ""
	@echo "与二次开发包的区别：本包不含 frontend 源码/services 骨架/skills 等开发工具，"
	@echo "前端已预构建在镜像中（registry/micro-server/frontend:${IMAGE_TAG}）。"
	@echo "如需二次开发，请使用完整分发包（coder-micro-services-*-airgap.tar.gz）。"

secrets:
	@bash bin/generate-secrets.sh

up:
	@bash bin/start-deploy.sh

down:
	@bash bin/stop.sh

status:
	@bash bin/status.sh

logs:
	@bash bin/logs.sh $(svc)

verify:
	@bash bin/verify.sh

load-images:
	@bash bin/load-images.sh
