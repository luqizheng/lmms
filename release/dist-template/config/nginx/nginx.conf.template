# nginx.conf.template — rendered by consul-template.
# Variables:
#   {{ range services }}{{ .Name }}{{ end }}  → list of service names
#   {{ range service "NAME" }}{{ .Address }}:{{ .Port }}{{ end }}  → upstream instances
#   Stable: services without `canary` tag; Canary: services with `canary` tag

server {
    listen 80;
    server_name localhost;

    location /health {
        return 200 '{"status":"ok"}';
        add_header Content-Type application/json;
    }

    {{ $services := "audit-service config-service file-service iam-service notification-service prue_backend token-service" }}

    {{ range $svc := split " " $services }}
    {{ $var := $svc | replaceAll "-" "_" }}
    upstream {{ $svc }}-stable {
        {{ range service $svc }}{{ if not (.Tags | contains "canary") }}
        server {{ .Address }}:{{ .Port }};
        {{ end }}{{ end }}
    }

    upstream {{ $svc }}-canary {
        {{ range service $svc }}{{ if .Tags | contains "canary" }}
        server {{ .Address }}:{{ .Port }};
        {{ end }}{{ end }}
    }

    # split_clients routes traffic by hashed request_id.
    # nginx variable names must be [A-Za-z0-9_] only — use $var with dashes
    # replaced by underscores.
    split_clients $request_id ${{ $var }}_backend {
        {{- if service (printf "canary.%s" $svc) }}
        10%   {{ $svc }}-canary;
        *     {{ $svc }}-stable;
        {{- else }}
        *     {{ $svc }}-stable;
        {{- end }}
    }
    {{ end }}

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api-gateway:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Canary $http_x_canary;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }
}