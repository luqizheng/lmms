# ─────────────────────────────────────────────────────────────────────────────
# coder-micro-services 发布配置模板（dist-v1.0.0）
# 复制为 .env 后用 `make secrets` 自动替换 __CHANGE_ME__ 占位符
# ─────────────────────────────────────────────────────────────────────────────

# ── 镜像仓库 ──
# 平台镜像（api-gateway / iam-service / ...）的仓库前缀。
# compose 里写作 ${kudi_repos:-<默认值>}/<svc>:<tag>，改本行即可整体换源。
kudi_repos=zhcoder-docker-registry.com:8000/micro-server

# 官方第三方镜像 —— 每个镜像一个变量，换源只改本文件对应行，无需动 compose。
# 默认值是官方裸名（国内直连 docker hub 不稳时，改成任意可达的镜像源即可，
# 例如 redis=redis:7-alpine → redis=docker.1ms.run/redis:7-alpine）。
#
# ⚠ air-gap 离线安装注意：镜像是从 images/*.tar 里 docker load 进来的，
#   tar 内的镜像名必须与本文件的值逐字一致 —— 离线端请勿改这些镜像变量，
#   否则 compose 会找不到镜像。换源只在「打包时」或「在线部署」时有效。
consul=hashicorp/consul:2.0.1
registrator=gliderlabs/registrator:master
redis=redis:7-alpine
mysql=mysql:8.0
rabbitmq=rabbitmq:3.13-management-alpine
prometheus=prom/prometheus:v2.51.0
alertmanager=quay.io/prometheus/alertmanager:v0.27.0
grafana=grafana/grafana:10.4.0
consul_template=hashicorp/consul-template:0.32.0
otel_collector=otel/opentelemetry-collector-contrib:0.96.0
jaeger=jaegertracing/all-in-one:1.55
loki=grafana/loki:3.3.2
promtail=grafana/promtail:3.3.2

# REGISTRY 写入 MANIFEST.json 的仓库字段（历史字段，保留兼容）
REGISTRY=zhcoder-docker-registry.com:8000
# IMAGE_TAG 必须用「不带 v」的镜像 tag：git tag 带 v（v1.5.0），但发布镜像 tag
# 不带 v —— CI build_images:tagged 用 ${CI_COMMIT_TAG#v} 剥 v 后推送，
# registry 里实际存在的是 micro-server/<svc>:1.5.0（不是 :v1.5.0）。
IMAGE_TAG=1.0.0

# ── 端口映射（按需修改）──
API_GATEWAY_PORT=3000
FRONTEND_PORT=8080

# ── MySQL ──
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_PORT_EXPORT=3306
MYSQL_DATABASE=superpowers
MYSQL_USER=app
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_HOST_AUTH_METHOD=mysql_native_password
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"

# Java 业务服务用的 JDBC URL（Spring Boot datasource）
DATABASE_URL_JDBC="jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"

# ── Redis ──
REDIS_PASSWORD=__CHANGE_ME__
REDIS_PORT=6379
REDIS_DATABASES=16
REDIS_HOST=redis

# ── RabbitMQ ──
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=__CHANGE_ME__
RABBITMQ_PORT=5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_MANAGEMENT_PORT=15672

# ── Consul（dev mode，8500 暴露 UI、8502 暴露 gRPC）──
CONSUL_HTTP_PORT=8500
CONSUL_GRPC_PORT=8502
CONSUL_HOST=consul

# ── Observability 端口 ──
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ── Service bootstrap tokens（用 make secrets 自动生成）──
IAM_DEV_BT=__CHANGE_ME__
TOKEN_DEV_BT=__CHANGE_ME__
NOTIFICATION_DEV_BT=__CHANGE_ME__
AUDIT_DEV_BT=__CHANGE_ME__
PRUE_DEV_BT=__CHANGE_ME__
GATEWAY_DEV_BT=__CHANGE_ME__
CONFIG_DEV_BT=__CHANGE_ME__
FILE_DEV_BT=__CHANGE_ME__
SERVICE_BOOTSTRAP_TOKENS=${IAM_DEV_BT},${TOKEN_DEV_BT},${NOTIFICATION_DEV_BT},${AUDIT_DEV_BT},${PRUE_DEV_BT},${GATEWAY_DEV_BT},${CONFIG_DEV_BT},${FILE_DEV_BT}

# ── 通用服务配置 ──
TENANT_ID=1
TOKEN_SERVICE_URL=http://token-service:8082
JWKS_URL=http://token-service:8082/.well-known/jwks.json

# ── Frontend 构建参数（make up 时注入到 docker build）──
VITE_API_BASE=/api
VITE_DISABLE_CAPTCHA=true