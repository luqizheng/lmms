/target
/reasonix
/.reasonix
/.temp/
*.swp
*.swo
.DS_Store
node_modules
*.exe
mysql_data/
redis_data/
frontend/coverage/
services/auth-service/bin/
services/user-service/bin/
release/dist-template/release/*

# iam-service seeds config.yaml on first boot from config.default.yaml (see
# services/iam-service/src/config.rs). The seeded file lives alongside its
# template on dev machines (because compose bind-mounts this dir), so ignore
# the runtime artifact to keep `git status` clean.
services/iam-service/config/config.yaml

# notification-service same pattern (see services/notification-service/src/config.rs).
services/notification-service/config/config.yaml
docker/mysql/data
sdk/dotnet/**/bin/
sdk/dotnet/**/obj/
sdk/java/**/target/
*.nuspec
reports/
/build-*.log.superpowers/
.superpowers/
/.worktrees/
/.omo/

# utoipa-swagger-ui build.rs 依赖的 vendor zip；已提交进 git（4.4MB），
# 避免 shell runner 无本地缓存时现场从 gh-proxy.org 下载超时
# （runner 50 实证 download timeout 120s）。升级时重下并重新提交。
/infrastructure/vendor/*
!/infrastructure/vendor/swagger-ui-v5.17.14.zip

# Docker registry 来源由 `pnpm run setup` 交互式向导写入（scripts/setup-wizard.js），
# 本地配置不入 git；CI 可用 CODER_BASE_REGISTRY / CODER_BUILDER_REGISTRY 环境变量覆盖。
/infrastructure/.docker-registry.json

# .cargo/credentials.toml 由 setup-wizard.js 写入（crates.io / mirror 的 auth token），
# 含敏感信息，本地配置不入 git；CI 可用 CODER_CRATE_TOKEN 环境变量覆盖。
/.cargo/credentials.toml

# .mvn/settings.xml + .mvn/maven.config 由 setup-wizard.js 写入（maven mirror + token），
# 含敏感信息，本地配置不入 git；CI 可用 CODER_MAVEN_REGISTRY / CODER_MAVEN_TOKEN 覆盖。
/.mvn/settings.xml
/.mvn/maven.config

# 项目根 .npmrc 由 setup-wizard.js 写入（npm mirror + token），含敏感信息，本地配置不入 git；
# CI 可用 CODER_NPM_REGISTRY / CODER_NPM_TOKEN 覆盖。
# 注意：只忽略项目根 .npmrc，不影响 tests/e2e/.npmrc 等子目录 .npmrc。
/.npmrc
# frontend/.npmrc 同样由 setup 脚本生成，含 npm mirror，本地配置不入 git
/frontend/.npmrc

apps/pm/**/target/
/apps/pm/.gitignore

# release/dist-template 是发布模板；最终 dist 由 CI 生成，不入 git
# 但模板本身（脚本/compose/Makefile/README）需要入 git
/release/dist-template/secrets/*.pem
/release/dist-template/.env

# Prod env / secrets — 由 start-prod.sh 加载；含 MYSQL_ROOT_PASSWORD / DB_PASSWORD /
# service-jwt bootstrap tokens 等敏感值。运维在 staging server 上手填，不入 git。
# `.env.prod.example` 是模板，已被 git 跟踪；`.env.prod` 是填充后的实际值。
/infrastructure/.env.prod
/infrastructure/.env.dev
/infrastructure/prod-secrets/
# frontend/ 由 release.sh 从 dev frontend/ 动态复制到分发包输出目录，不入 git；
# CI 通过 build-frontend.sh 直接用 dev frontend/ 构建镜像，不依赖此目录快照
/release/dist-template/frontend/
/release/dist-template/release/
/release/dist-*.tar.gz
/release/images-*.tar.gz
/release/dist-template/frontend-source-*.tar.gz
