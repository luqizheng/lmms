{
  "services": [
    {
      "name": "api-gateway",
      "id": "api-gateway",
      "address": "api-gateway",
      "port": 3000,
      "check": {
        "name": "http",
        "http": "http://api-gateway:3000/health",
        "interval": "10s",
        "timeout": "5s"
      }
    },
    {
      "name": "prue_backend",
      "id": "prue_backend",
      "address": "prue_backend",
      "port": 8080,
      "check": {
        "name": "http",
        "http": "http://prue_backend:8080/health",
        "interval": "10s",
        "timeout": "5s"
      }
    }
  ]
}
