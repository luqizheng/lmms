# REDIS_PASSWORD
REDIS_PASSWORD=yourpassword
REDIS_PORT=6379
REDIS_DATABASES=16
REDIS_HOST=redis

# mysql
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_PORT_EXPORT=3306
MYSQL_DATABASE=superpowers
# MYSQL_USER must NOT be "root" — MySQL 镜像硬性拒绝 (MYSQL_USER/MYSQL_PASSWORD 仅用于非 root 账号)。
# root 密码通过 MYSQL_ROOT_PASSWORD 控制。DATABASE_URL 用 MYSQL_USER 连接，权限由镜像在启动时 GRANT ALL on MYSQL_DATABASE 自动赋予。
MYSQL_USER=app
MYSQL_PASSWORD=apppass
MYSQL_HOST_AUTH_METHOD=mysql_native_password
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"

# rabbitmq
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_MANAGEMENT_PORT=15672
# consul ports (dev)
CONSUL_HTTP_PORT=8500
CONSUL_GRPC_PORT=8502
CONSUL_HOST=consul

# iconify
ICONIFY_PORT=28080

# help center attachment
HELP_CENTER_ATTACHMENT_PORT=28943

# Phase 9: project-service host port (Java + Spring Boot, port 8080 inside).
PROJECT_SERVICE_PORT_EXPORT=6008

# registrator: per-service env (filled in by compose via ${SERVICE_*})
# These defaults are placeholders; each service sets its own values via
# the SERVICE_* env keys in docker-compose-services.yml.
SERVICE_NAME=
SERVICE_ID=
SERVICE_PORT=
SERVICE_HEALTH_PATH=

# Phase 5-B: service-jwt bootstrap tokens (dev only; prod uses secret manager)
IAM_DEV_BT=dev-bt-iam-service
TOKEN_DEV_BT=dev-bt-token-service
NOTIFICATION_DEV_BT=dev-bt-notification-service
AUDIT_DEV_BT=dev-bt-audit-service
PRUE_DEV_BT=dev-bt-prue-backend
GATEWAY_DEV_BT=dev-bt-api-gateway
CONFIG_DEV_BT=dev-bt-config-service
FILE_DEV_BT=dev-bt-file-service
SERVICE_BOOTSTRAP_TOKENS=${IAM_DEV_BT},${TOKEN_DEV_BT},${NOTIFICATION_DEV_BT},${AUDIT_DEV_BT},${PRUE_DEV_BT},${GATEWAY_DEV_BT},${CONFIG_DEV_BT},${FILE_DEV_BT}
TENANT_ID=1
TOKEN_SERVICE_URL=http://token-service:8082
JWKS_URL=http://token-service:8082/.well-known/jwks.json

# ---------------------------------------------------------------------------
# PM Platform (apps/pm — Spring Boot 3, JDK 21, port 8088)
# ---------------------------------------------------------------------------
# PM uses a dedicated schema `pm_platform` in the same MySQL instance.
# Unlike Rust services which take a `mysql://` URL, Spring Boot requires a
# JDBC URL (jdbc:mysql://...). The init script in infrastructure/mysql-init/
# creates the schema and grants MYSQL_USER access on first boot.
PM_SPRING_PROFILE=dev
PM_DATABASE=pm_platform
PM_JDBC_URL=jdbc:mysql://mysql:3306/pm_platform?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
PM_JWT_MODE=noop
PM_LLM_PROVIDER=noop
PM_SDK_BEARER=dev-bypass-token

# ---------------------------------------------------------------------------
# project-service (services/project-service — Spring Boot 3, JDK 25, port 8080)
# ---------------------------------------------------------------------------
# Java/Spring Boot service that shares the `superpowers` schema (pmd_* tables).
# Needs a JDBC URL, not the Rust-style mysql:// URL in DATABASE_URL.
PROJECT_JDBC_URL=jdbc:mysql://mysql:3306/superpowers?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
