# ── Docker base image mirror ─────────────────────────────────────────────────
# docker compose 中所有 base image 通过 ${BASE_REGISTRY}<image> 引用；镜像名末尾冒号
# 前的斜杠由本变量承载。`pnpm run setup:wizard` 会在 `.docker-registry.json` 中
# baseRegistry 变更后同步本行（参见 scripts/base-images-sync.js）。CI 走
# .gitlab-ci.yml 的 variables: BASE_REGISTRY（与本行默认值保持一致）。
#
# 注意：compose 的运行时镜像已改为「每个镜像一个变量」（见下方「镜像来源」），
# BASE_REGISTRY 现在只服务于 Dockerfile 的 FROM 与 CI job image —— compose 不再引用它。
BASE_REGISTRY=zhcoder-docker-registry.com:8000/official/

# ── 镜像来源 ──────────────────────────────────────────────────────────────────
# compose 里每个 image: 都是 ${VAR:-默认值} 形式，换源只改本文件对应行。
# 默认值指向内网 registry（开发机在内网，比直连 docker hub 稳）；
# 国内离线环境可改成任意可达源，例如 docker.1ms.run/xxx。
kudi_repos=zhcoder-docker-registry.com:8000/micro-server
consul=zhcoder-docker-registry.com:8000/official/hashicorp/consul:2.0.1
registrator=zhcoder-docker-registry.com:8000/official/gliderlabs/registrator:master
redis=zhcoder-docker-registry.com:8000/official/redis:7-alpine
mysql=zhcoder-docker-registry.com:8000/official/mysql:8.0
rabbitmq=zhcoder-docker-registry.com:8000/official/rabbitmq:3.13-management-alpine
prometheus=zhcoder-docker-registry.com:8000/official/prom/prometheus:v2.51.0
alertmanager=zhcoder-docker-registry.com:8000/official/prometheus/alertmanager:v0.27.0
grafana=zhcoder-docker-registry.com:8000/official/grafana/grafana:10.4.0
consul_template=zhcoder-docker-registry.com:8000/official/hashicorp/consul-template:0.32.0
otel_collector=zhcoder-docker-registry.com:8000/official/otel/opentelemetry-collector-contrib:0.96.0
jaeger=zhcoder-docker-registry.com:8000/official/jaegertracing/all-in-one:1.55
loki=zhcoder-docker-registry.com:8000/official/grafana/loki:3.3.2
promtail=zhcoder-docker-registry.com:8000/official/grafana/promtail:3.3.2

# REDIS_PASSWORD
REDIS_PASSWORD=yourpassword
REDIS_PORT=6379
REDIS_DATABASES=16
REDIS_HOST=redis

# mysql
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_PORT_EXPORT=3306
MYSQL_DATABASE=superpowers
# MYSQL_USER must NOT be "root" — MySQL 镜像硬性拒绝 (MYSQL_USER/MYSQL_PASSWORD 仅用于非 root 账号)。
# root 密码通过 MYSQL_ROOT_PASSWORD 控制。DATABASE_URL 用 MYSQL_USER 连接，权限由镜像在启动时 GRANT ALL on MYSQL_DATABASE 自动赋予。
MYSQL_USER=app
MYSQL_PASSWORD=apppass
MYSQL_HOST_AUTH_METHOD=mysql_native_password
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"

# MySQL replication (used by mysql-replica service).
# The replication user must already exist on the primary with REPLICATION SLAVE
# privilege — see docs-site/runbooks/mysql-replication.md §1 for one-time setup.
# Override MYSQL_PRIMARY_HOST if replica connects to a different primary (e.g.
# remote DR site or promoted replica during failover).
MYSQL_PRIMARY_HOST=${MYSQL_HOST}
MYSQL_PRIMARY_PORT=3306
MYSQL_REPL_USER=repl
MYSQL_REPL_PASSWORD=replpass

# postgres（可选方言：`--profile pg` 启用；默认编排仍是 MySQL）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PORT_EXPORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=coder
POSTGRES_DB=coder
POSTGRES_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# rabbitmq
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_MANAGEMENT_PORT=15672
# consul ports (dev)
CONSUL_HTTP_PORT=8500
CONSUL_GRPC_PORT=8502
CONSUL_HOST=consul

# iconify
ICONIFY_PORT=28080

# help center attachment
HELP_CENTER_ATTACHMENT_PORT=28943


# SERVICE_NAME：被 libs/digua_common_ratelimit 读取（log/audit 标签）。
# 仅 SERVICE_NAME 走容器 env 通道；SERVICE_ID / SERVICE_PORT / SERVICE_HEALTH_PATH
# 现在只通过 docker-compose labels 通道给 registrator 消费（service registration
# 元数据），不再注入到容器 env，所以此处不再列这些占位。
SERVICE_NAME=

# Phase 5-B: service-jwt bootstrap tokens (dev only; prod uses secret manager)
IAM_DEV_BT=dev-bt-iam-service
TOKEN_DEV_BT=dev-bt-token-service
NOTIFICATION_DEV_BT=dev-bt-notification-service
AUDIT_DEV_BT=dev-bt-audit-service
PRUE_DEV_BT=dev-bt-prue-backend
GATEWAY_DEV_BT=dev-bt-api-gateway
CONFIG_DEV_BT=dev-bt-config-service
FILE_DEV_BT=dev-bt-file-service
SERVICE_BOOTSTRAP_TOKENS=${IAM_DEV_BT},${TOKEN_DEV_BT},${NOTIFICATION_DEV_BT},${AUDIT_DEV_BT},${PRUE_DEV_BT},${GATEWAY_DEV_BT},${CONFIG_DEV_BT},${FILE_DEV_BT}
TENANT_ID=1
TOKEN_SERVICE_URL=http://token-service:8082
JWKS_URL=http://token-service:8082/.well-known/jwks.json

