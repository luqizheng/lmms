# infrastructure/lmms-pg-dev/.env.example —— 本机开发环境模板（PostgreSQL 方言）
# ─────────────────────────────────────────────────────────────────────────────
# 用法：cp .env.example .env（本文件入库无凭据；.env 不入库）
# 前置：先启动 ../infra-pg（同一 superpowers 网络）：
#   ../infra-pg/start.ps1 -Dev     /     ../infra-pg/start.sh --dev
# 本目录只跑 lmms 业务服务，consul / postgres / redis / rabbitmq 全部由 infra-pg 提供。
# 注意：服务按 postgres feature 编译（见 docker-compose-lmms.yml 的 build args），
#       切回 MySQL 请改用 ../lmms-mysql-dev，两套栈互斥勿同时启动。
# ─────────────────────────────────────────────────────────────────────────────

# ── 服务发现与自注册（同机部署用容器 DNS 默认值）──
CONSUL_ADDR=http://consul:8500
# 跨主机才需要填本机 LAN IP（consul 健康检查回拨地址），同机留空
SERVICE_ADDRESS=

# ── 数据库：infra-pg 提供（默认凭据与 infra-pg/.env.example 一致）──
# 方言由 URL scheme 判定（postgres://）；建池与迁移选 postgres 分支
DATABASE_URL=postgres://postgres:coder@postgres:5432/coder

# ── 中间件：infra-pg 提供 ──
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ── 可观测（observability 未启动时导出失败不阻塞业务）──
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── 栈内互访（容器名 DNS，services 组内同机恒定）──
TENANT_ID=1
TOKEN_SERVICE_URL=http://token-service:8082
JWKS_URL=http://token-service:8082/.well-known/jwks.json

# ── Service-JWT bootstrap tokens（dev 固定值）──
# token-service 启动时按 owner 补插到 token_bootstrap_tokens 表。
# env 未设置时自动回退到 token-service 内置的 dev 默认值（同一批 dev-bt-* 值）。
# ⚠️ 两列必须等长且顺序一一对应（长度不一致则 token-service 拒绝启动）。
IAM_DEV_BT=dev-bt-iam-service
TOKEN_DEV_BT=dev-bt-token-service
NOTIFICATION_DEV_BT=dev-bt-notification-service
AUDIT_DEV_BT=dev-bt-audit-service
PRUE_DEV_BT=dev-bt-prue-backend
GATEWAY_DEV_BT=dev-bt-api-gateway
FILE_DEV_BT=dev-bt-file-service
SERVICE_BOOTSTRAP_TOKENS=dev-bt-iam-service,dev-bt-token-service,dev-bt-notification-service,dev-bt-audit-service,dev-bt-prue-backend,dev-bt-api-gateway,dev-bt-file-service
SERVICE_BOOTSTRAP_OWNERS=iam-service,token-service,notification-service,audit-service,prue_backend,api-gateway,file-service
