{
  "services": [
    {
      "name": "auth-service",
      "port": 5000,
      "check": {
        "name": "http",
        "http": "http://auth-service:5000/health",
        "interval": "10s",
        "timeout": "5s"
      }
    },
    {
      "name": "token-service",
      "port": 8080,
      "check": {
        "name": "http",
        "http": "http://token-service:8080/health",
        "interval": "10s",
        "timeout": "5s"
      }
    },
    {
      "name": "user-service",
      "port": 6000,
      "check": {
        "name": "http",
        "http": "http://user-service:6000/health",
        "interval": "10s",
        "timeout": "5s"
      }
    }
  ]
}
